  // bare number changes meaning if the org currency setting changes.
  currency           String       @default("SAR")
  status             String       @default("pending")
  collectedDate      DateTime?
  collectedPaymentId String?
  deductions         Json         @default("[]")
  refundAmount       Decimal?     @db.Decimal(14, 2)
  refundDate         DateTime?
  refundMethod       String?
  refundPaymentId    String?
  refundNotes        String?
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
  @@index([leaseId, tenantId])
  @@index([unitId])
  @@index([propertyId])
  @@index([status])
  @@map("security_deposits")
}

model Expense {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  expenseNumber   String?
  propertyId      String?
  property        Property?    @relation(fields: [propertyId], references: [id])
  unitId          String?
  category        String
  description     String
  amount          Decimal      @db.Decimal(14, 2)
  currency        String       @default("SAR")
  date            DateTime
  paymentMethod   String?
  referenceNumber String?
  receiptUrl      String?
  notes           String?
  isRecurring     Boolean      @default(false)
  recurringConfig Json?
  status          String       @default("paid")
  taxDeductible   Boolean      @default(false)
  // ---- Accounting phase 0 (migration 20261004121500_accounting_phase0) ----
  // Left out of every read by the client until asked for, as on Invoice.
  /// The VAT inside `amount` (amount is what was paid, VAT included). NOT
  /// NULL DEFAULT 0 in the database; no default here, as on Invoice.
  vatAmount             Decimal?  @db.Decimal(14, 2)
  /// S | Z | E | O, as on an invoice line; null when not recorded.
  vatCategory           String?
  supplierId            String?
  supplier              Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// The supplier's own invoice number.
  supplierInvoiceNumber String?
  createdById     String
  createdBy       User         @relation("ExpenseCreator", fields: [createdById], references: [id])
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, expenseNumber])
  @@index([propertyId, date(sort: Desc)])
  @@index([category, status])
  @@index([createdById, date(sort: Desc)])
  @@index([supplierId])
  @@map("expenses")
}

/**
 * Someone the office buys from (migration 20261004121500_accounting_phase0):
 * the minimum an expense needs to name its supplier and claim its VAT. The
 * purchases module (migration 20261004190000_purchases) adds the contact, the
 * bank details to pay into and the payment terms; the supplier's balance is
 * not stored but read from the books (the party's lines on the suppliers'
 * payable account).
 */
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  vatNumber      String?
  phone          String?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // ---- Purchases (migration 20261004190000_purchases) ----
  // Left out of every read by the client (src/lib/db/prisma.ts) so a page that
  // does not show them works before the migration; the purchases screens ask
  // for them (src/lib/accounting/purchases/availability.ts).
  contactName      String?
  email            String?
  address          String?
  city             String?
  /// Commercial registration number.
  crNumber         String?
  bankName         String?
  iban             String?
  /// Days from a bill's date to when it falls due; null: due on its date.
  paymentTermsDays Int?
  notes            String?

  expenses Expense[]
  bills    PurchaseBill[]
  vouchers PaymentVoucher[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("suppliers")
}

/**
 * A supplier's invoice to the office (migration 20261004190000_purchases).
 * Entered `pending`, approved by someone holding the right, then owed: the
 * ledger posts it on `billDate` once approved (Dr the lines' accounts and
 * input VAT / Cr suppliers' payable, src/lib/accounting/posting/purchase.ts).
 * `partially_paid` and `paid` follow the vouchers allocated to it
 * (`amountPaid` is kept equal to the sum of its allocations on vouchers not
 * cancelled); `cancelled` posts nothing. Numbered in sequence per
 * organization (BILL-000123). The same supplier's invoice number is entered
 * once among bills not cancelled — a partial unique index in the migration.
 */
model PurchaseBill {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  number                Int
  supplierId            String
  supplier              Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// The supplier's own number for the invoice.
  supplierInvoiceNumber String?
  /// Calendar days (midnight UTC), as the ledger's entries are.
  billDate              DateTime
  dueDate               DateTime
  /// pending | approved | partially_paid | paid | cancelled
  status                String       @default("pending")
  currency              String       @default("SAR")
  /// The lines' value before the discount.
  subtotal              Decimal      @db.Decimal(14, 2)
  /// Taken before VAT, spread over the lines.
  discountAmount        Decimal      @default(0) @db.Decimal(14, 2)
  vatAmount             Decimal      @default(0) @db.Decimal(14, 2)
  totalAmount           Decimal      @db.Decimal(14, 2)
  amountPaid            Decimal      @default(0) @db.Decimal(14, 2)
  notes                 String?
  approvedById          String?
  approvedAt            DateTime?
  cancelledById         String?
  cancelledAt           DateTime?
  cancelReason          String?
  createdById           String?
  version               Int          @default(0) // optimistic concurrency (see Payment.version)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  lines       PurchaseBillLine[]
  allocations PaymentVoucherAllocation[]

  // Partial unique (organizationId, supplierId, supplierInvoiceNumber) WHERE
  // the number is not null AND status <> 'cancelled' is in the SQL migration
  // (purchase_bills_supplier_invoice_unique).
  @@unique([organizationId, number])
  @@index([organizationId, billDate])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, status, dueDate])
  @@map("purchase_bills")
}

/**
 * One line of a purchase bill: what was bought, the ledger account it is
 * charged to, its own VAT treatment, and the building and unit it belongs to
 * (the cost centre, plain columns as on a journal line). Amounts as on an
 * invoice line: net = quantity × unitPrice − the line's share of the bill's
 * discount; vatAmount = net × vatRate %; total = net + vatAmount.
 */
model PurchaseBillLine {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  billId         String
  bill           PurchaseBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  position       Int           @default(0)
  description    String
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  quantity       Decimal       @default(1) @db.Decimal(14, 3)
  unitPrice      Decimal       @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @db.Decimal(14, 2)
  netAmount      Decimal       @db.Decimal(14, 2)
  /// S standard | Z zero-rated | E exempt | O out of scope — the ledger's
  /// VAT codes (src/lib/accounting/types.ts).
  vatCategory    String
  /// Percent (15 = 15%); 0 unless the line is standard-rated.
  vatRate        Decimal       @default(0) @db.Decimal(6, 3)
  vatAmount      Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal       @db.Decimal(14, 2)
  propertyId     String?
  unitId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([billId])
  @@index([accountId])
  @@map("purchase_bill_lines")
}

/**
 * Money the office paid out — a payment voucher (سند صرف), numbered in
 * sequence per organization (PV-000045) and drawn on one of its bank or cash
 * accounts. The ledger posts it on `voucherDate` (Dr suppliers' payable /
 * Cr the account). Its allocations say which bills it paid; what is left
 * over is on account with the supplier. Cancelling it keeps the number and
 * releases the bills.
 */
model PaymentVoucher {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  number         Int
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  voucherDate    DateTime
  bankAccountId  String
  bankAccount    BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  amount         Decimal      @db.Decimal(14, 2)
  currency       String       @default("SAR")
  /// cash | bank_transfer | cheque | card | other
  method         String       @default("bank_transfer")
  /// The cheque or transfer number.
  reference      String?
  notes          String?
  /// posted | cancelled
  status         String       @default("posted")
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  allocations PaymentVoucherAllocation[]

  @@unique([organizationId, number])
  @@index([organizationId, voucherDate])
  @@index([organizationId, supplierId, status])
  @@index([bankAccountId])
  @@map("payment_vouchers")
}

/** How much of a voucher paid a bill. One per voucher and bill. */
model PaymentVoucherAllocation {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  voucherId      String
  voucher        PaymentVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  billId         String
  bill           PurchaseBill   @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount         Decimal        @db.Decimal(14, 2)
  createdAt      DateTime       @default(now())

  @@unique([voucherId, billId])
  @@index([billId])
  @@index([organizationId])
  @@map("payment_voucher_allocations")
}

// ============================================================================
// LEDGER — the office's double-entry books (migration 20261003170001_ledger)
// ============================================================================

/**
 * One account of the office's chart of accounts.
 * Seeded per organization from the Saudi template (src/lib/accounting/
 * coa-template.ts) when accounting is set up, then the office's to shape:
 * add, rename, renumber, move, deactivate. Only `postable` accounts take
 * journal lines; the rest are headings. An account with lines is never
 * deleted (the journal_lines foreign key refuses it), and one a posting rule
 * uses — `systemKey` set, or reached through AccountingSettings.accountMap —
 * is protected by src/lib/accounting/coa-rules.ts.
 */
model LedgerAccount {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  code           String
  nameAr         String
  nameEn         String
  /**
   * asset | liability | equity | income | expense
   */
  type           String
  /**
   * debit | credit — the side its balance ordinarily sits on.
   */
  normalSide     String
  parentId       String?
  parent         LedgerAccount?  @relation("LedgerAccountTree", fields: [parentId], references: [id])
  children       LedgerAccount[] @relation("LedgerAccountTree")
  postable       Boolean         @default(true)
  /**
   * The posting job the template created this account for (cash_on_hand,
   * owner_payable, …) — see src/lib/accounting/system-keys.ts. Unique per
   * organization when set.
   */
  systemKey      String?
  active         Boolean         @default(true)
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  lines        JournalLine[]
  bankAccounts BankAccount[]
  billLines    PurchaseBillLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@index([organizationId, parentId])
  @@map("ledger_accounts")
}

/**
 * A journal entry. Numbered in sequence per organization, dated by calendar
 * day (midnight UTC). An entry posted from a document of the app carries the
 * document as `sourceType` + `sourceId`, and only one such entry is live per
 * document at a time (partial unique index journal_entries_live_source_unique
 * in the migration); a changed document replaces its entry while the period
 * is open and is reversed and reposted once it is closed
 * (src/lib/accounting/periods.ts). Nothing is deleted once its period is
 * closed: a reversal is a new entry pointing back at `reversesId`, and the
 * original is marked reversed. A deferred trigger refuses any entry whose
 * lines do not balance.
 */
model JournalEntry {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  number         Int
  date           DateTime
  /**
   * manual | opening_balance | invoice | payment | payment_refund | expense |
   * deposit_receipt | deposit_settlement | bank_transfer | owner_settlement |
   * owner_payout
   */
  sourceType     String
  sourceId       String?
  /**
   * What the screens show for the source — an invoice or payment number.
   */
  sourceRef      String?
  memo           String?
  /**
   * posted | reversed
   */
  status         String         @default("posted")
  reversesId     String?
  reverses       JournalEntry?  @relation("JournalReversal", fields: [reversesId], references: [id])
  reversedBy     JournalEntry[] @relation("JournalReversal")
  /**
   * Total of the debits (= total of the credits), kept equal by the trigger.
   */
  totalAmount    Decimal        @db.Decimal(14, 2)
  currency       String         @default("SAR")
  /**
   * Digest of what the source called for when it was posted — reposting an
   * unchanged document is then a no-op.
   */
  fingerprint    String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines JournalLine[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([organizationId, sourceType, sourceId])
  @@index([reversesId])
  @@map("journal_entries")
}

/**
 * One line of a journal entry: a debit or a credit to one account, with the
 * party whose sub-ledger it belongs to (a tenant's receivable, an owner's
 * payable) and the building, unit, contract and agreement it concerns. The
 * dimension ids are plain columns, not foreign keys: the books outlive the
 * records they describe. `date` repeats the entry's date for the reports'
 * indexes; the trigger keeps the two equal.
 */
model JournalLine {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  entryId        String
  entry          JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  lineNo         Int           @default(0)
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  date           DateTime
  debit          Decimal       @default(0) @db.Decimal(14, 2)
  credit         Decimal       @default(0) @db.Decimal(14, 2)
  /**
   * tenant | owner | supplier | customer
   */
  partyType      String?
  partyId        String?
  propertyId     String?
  unitId         String?
  leaseId        String?
  agreementId    String?
  /**
   * S standard | Z zero-rated | E exempt | O out of scope.
   */
  vatCode        String?
  memo           String?
  createdAt      DateTime      @default(now())

  /// Set once the line is ticked off against the bank statement.
  reconciliation BankReconciledLine?

  @@index([entryId])
  @@index([organizationId, accountId, date])
  @@index([organizationId, partyType, partyId])
  @@index([organizationId, propertyId])
  @@map("journal_lines")
}

/**
 * How an organization keeps its books: from when (`cutOverDate` — documents
 * dated before it are not posted; opening balances carry them), closed
 * through when (`closedThrough` — the period lock), VAT registration, who
 * holds tenants' deposits on owners' buildings, and which account does each
 * posting job (`accountMap`, system key → LedgerAccount id). One row per
 * organization, created by "set up accounting"; `lastJournalNumber` is the
 * journal number counter, locked by every posting transaction.
 */
model AccountingSettings {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  organization      Organization @relation(fields: [organizationId], references: [id])
  cutOverDate       DateTime?
  closedThrough     DateTime?
  vatRegistered     Boolean      @default(false)
  vatNumber         String?
  /**
   * accrual — the only basis today.
   */
  basis             String       @default("accrual")
  /**
   * owner | office — who holds a tenant's deposit on an owner's building.
   */
  depositHolder     String       @default("owner")
  accountMap        Json         @default("{}")
  lastJournalNumber Int          @default(0)
  templateVersion   String?
  setupAt           DateTime?
  setupById         String?
  lastSweepAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("accounting_settings")
}

/**
 * A bank, cash, POS or gateway account of the office, kept in one postable
 * ledger account each.
 */
model BankAccount {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  ledgerAccountId String         @unique
  ledgerAccount   LedgerAccount  @relation(fields: [ledgerAccountId], references: [id])
  /**
   * bank | cash | pos | gateway_clearing
   */
  kind            String         @default("bank")
  name            String
  bankName        String?
  iban            String?
  accountNumber   String?
  currency        String         @default("SAR")
  active          Boolean        @default(true)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  transfersOut BankTransfer[] @relation("BankTransferFrom")
  transfersIn  BankTransfer[] @relation("BankTransferTo")
  payouts      OwnerPayout[]
  vouchers     PaymentVoucher[]
  reconciled   BankReconciledLine[]

  @@index([organizationId, kind])
  @@map("bank_accounts")
}

/**
 * Money moved between two of the office's own accounts.
 */
model BankTransfer {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  fromBankAccountId String
  fromBankAccount   BankAccount  @relation("BankTransferFrom", fields: [fromBankAccountId], references: [id])
  toBankAccountId   String
  toBankAccount     BankAccount  @relation("BankTransferTo", fields: [toBankAccountId], references: [id])
  amount            Decimal      @db.Decimal(14, 2)
  date              DateTime
  reference         String?
  memo              String?
  /**
   * posted | reversed
   */
  status            String       @default("posted")
  journalEntryId    String?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, date])
  @@map("bank_transfers")
}

/**
 * An owner's period, settled: the figures of their statement for it, and the
 * entry that took the office's commission (and the VAT on it) out of the
 * owner's payable and credited any investment rent. `ownerId` is the owner's
 * User id — a plain column, so the books survive the archive.
 */
model OwnerSettlement {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  ownerId             String
  agreementId         String?
  periodStart         DateTime
  periodEnd           DateTime
  collected           Decimal      @default(0) @db.Decimal(14, 2)
  ownerReceivedDirect Decimal      @default(0) @db.Decimal(14, 2)
  commission          Decimal      @default(0) @db.Decimal(14, 2)
  commissionVat       Decimal      @default(0) @db.Decimal(14, 2)
  expenses            Decimal      @default(0) @db.Decimal(14, 2)
  investmentRent      Decimal      @default(0) @db.Decimal(14, 2)
  /**
   * What the period leaves the office owing the owner (negative: the owner
   * owing the office).
   */
  netDue              Decimal      @default(0) @db.Decimal(14, 2)
  currency            String       @default("SAR")
  /**
   * closed | reversed
   */
  status              String       @default("closed")
  journalEntryId      String?
  notes               String?
  createdById         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId, ownerId, periodStart])
  @@map("owner_settlements")
}

/**
 * Money paid to an owner out of what the office holds for them.
 */
model OwnerPayout {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ownerId        String
  amount         Decimal      @db.Decimal(14, 2)
  date           DateTime
  bankAccountId  String
  bankAccount    BankAccount  @relation(fields: [bankAccountId], references: [id])
  reference      String?
  notes          String?
  /**
   * posted | reversed
   */
  status         String       @default("posted")
  journalEntryId String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, ownerId, date])
  @@map("owner_payouts")
}

/**
 * A line of a bank or cash account ticked off against the bank's statement
 * (migration 20261004190000_purchases). Kept apart from journal_lines, which
 * the closed-period guard locks: a line in a closed period can still be
 * reconciled. The tick goes with the line when its document's entry is
 * replaced in an open period; the new line then waits to be ticked again.
 */
model BankReconciledLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  bankAccountId  String
  bankAccount    BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  journalLineId  String       @unique
  journalLine    JournalLine  @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  /// The day the bank cleared it (a calendar day, midnight UTC).
  reconciledOn   DateTime
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, bankAccountId])
  @@map("bank_reconciled_lines")
}

// ============================================================================
// OPERATIONS
// ============================================================================

model MaintenanceRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  unitId         String?
  tenantId       String
  tenant         User         @relation("MaintenanceTenant", fields: [tenantId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])
  title          String
  description    String
  priority       String       @default("medium")
  status         String       @default("submitted")
  category       String
  contactPhone   String?
  images         String[]     @default([])
  estimatedCost  Decimal?     @db.Decimal(14, 2)
  actualCost     Decimal?     @db.Decimal(14, 2)
  scheduledDate  DateTime?
  completedDate  DateTime?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workOrders WorkOrder[]

  @@index([organizationId])
  @@index([propertyId, status])
  @@index([tenantId, status])
  @@index([assignedToId, status])
  @@index([status, priority])
  @@index([createdAt(sort: Desc)])
  @@map("maintenance_requests")
}

model WorkOrder {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  maintenanceRequestId String
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
  assignedToId         String
  assignedTo           User               @relation("WorkOrderAssignee", fields: [assignedToId], references: [id])
  title                String
  description          String
  status               String             @default("pending")
  priority             String             @default("medium")
  estimatedCost        Decimal?           @db.Decimal(14, 2)
  actualCost           Decimal?           @db.Decimal(14, 2)
  scheduledDate        DateTime?
  completedDate        DateTime?
  notes                String?
  materials            String[]           @default([])
  laborHours           Float?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId])
  @@index([maintenanceRequestId, status])
  @@index([assignedToId, status])
  @@index([scheduledDate, status])
  @@map("work_orders")
}

model Ticket {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  ticketNumber    String?
  tenantId        String
  tenant          User         @relation("TicketTenant", fields: [tenantId], references: [id])
  propertyId      String?
  unitId          String?
  assignedToId    String?
  assignedTo      User?        @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdByUserId String
  createdByRole   String
  title           String
  description     String
  category        String
  priority        String       @default("medium")
  status          String       @default("open")
  attachments     String[]     @default([])
  comments        Json         @default("[]")
  resolvedAt      DateTime?
  closedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, ticketNumber])
  @@index([tenantId, status])
  @@index([status, priority])
  @@index([assignedToId, status])
  @@index([createdAt(sort: Desc)])
  @@map("tickets")
}

model Inspection {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  propertyId         String
  property           Property     @relation(fields: [propertyId], references: [id])
  tenantId           String?
  leaseId            String?
  type               String
  status             String       @default("scheduled")
  scheduledDate      DateTime
  completedDate      DateTime?
  inspectorId        String
  inspector          User         @relation("InspectionInspector", fields: [inspectorId], references: [id])
  items              Json         @default("[]")
  overallCondition   String?
  tenantSignature    Json?
  inspectorSignature Json?
  photos             String[]     @default([])
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
  @@index([propertyId, type])
  @@index([status, scheduledDate])
  @@index([inspectorId])
  @@map("inspections")
}

model Document {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  description       String?
  type              String       @default("other")
  category          String       @default("general")
  fileUrl           String
  fileSize          Float
  mimeType          String
  uploadedById      String
  uploadedBy        User         @relation("DocumentUploader", fields: [uploadedById], references: [id])
  tenantId          String?
  propertyId        String?
  leaseId           String?
  sharedWith        String[]     @default([])
  tags              String[]     @default([])
  status            String       @default("active")
  isRequired        Boolean      @default(false)
  expiresAt         DateTime?
  r2ObjectKey       String?
  downloadCount     Int          @default(0)
  lastDownloadedAt  DateTime?
  uploadedAt        DateTime     @default(now())
  versions          Json         @default("[]")
  currentVersion    Int          @default(1)
  digitalSignatures Json         @default("[]")
  requiresSignature Boolean      @default(false)
  signatureDeadline DateTime?
  accessLogs        Json         @default("[]")
  sharing           Json         @default("{}")
  templateId        String?
  isTemplate        Boolean      @default(false)
  autoGenerated     Boolean      @default(false)
  parentDocumentId  String?
  metadata          Json         @default("{}")
  encryption        Json         @default("{}")
  compliance        Json         @default("{}")
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
  @@index([uploadedById, createdAt(sort: Desc)])
  @@index([tenantId, type])
  @@index([propertyId, category])
  @@index([leaseId])
  @@index([type, status])
  @@map("documents")
}

model DocumentTemplate {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  description      String?
  category         String       @default("other")
  type             String
  version          String       @default("1.0.0")
  content          String
  sections         Json         @default("[]")
  variables        Json         @default("[]")
  styles           Json         @default("{}")
  outputFormat     String       @default("pdf")
  autoGenerate     Boolean      @default(false)
  generateTriggers String[]     @default([])
  createdById      String
  isPublic         Boolean      @default(false)
  allowedRoles     String[]     @default([])
  usageCount       Int          @default(0)
  lastUsed         DateTime?
  status           String       @default("draft")
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@index([category, status])
  @@index([createdById, status])
  @@map("document_templates")
}

// ============================================================================
// MESSAGING
// ============================================================================

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String?
  description    String?
  type           String // individual | group | announcement
  participants   Json         @default("[]") // detailed participant records
  participantIds String[]     @default([]) // active participant user ids (queryable)
  createdById    String
  propertyId     String?
  lastMessage    Json?
  settings       Json         @default("{}")
  avatar         String?
  isArchived     Boolean      @default(false)
  isPinned       Boolean      @default(false)
  tags           String[]     @default([])
  metadata       Json         @default("{}")
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages        Message[]
  messageStatuses MessageStatus[]

  @@index([organizationId])
  @@index([participantIds], type: Gin)
  @@index([type, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("conversations")
}

model Message {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  senderId        String
  sender          User         @relation("MessageSender", fields: [senderId], references: [id])
  recipientId     String?
  propertyId      String?
  subject         String?
  content         String
  messageType     String       @default("general")
  priority        String       @default("normal")
  status          String       @default("sent")
  attachments     Json         @default("[]")
  readAt          DateTime?
  deliveredAt     DateTime?
  readBy          Json         @default("[]")
  replyToId       String?
  forwardedFromId String?
  isSystemMessage Boolean      @default(false)
  isEdited        Boolean      @default(false)
  editedAt        DateTime?
  editHistory     Json         @default("[]")
  mentions        String[]     @default([])
  metadata        Json?
  deletedAt       DateTime?
  deletedById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  statuses MessageStatus[]

  @@index([organizationId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@index([recipientId, status])
  @@map("messages")
}

model MessageStatus {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  messageId      String
  // Status rows die with their message/conversation — without these FKs a
  // hard delete orphaned per-recipient status rows forever.
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageStatusSender", fields: [senderId], references: [id])
  recipientId    String
  recipient      User         @relation("MessageStatusRecipient", fields: [recipientId], references: [id])
  status         String       @default("sent")
  deliveredAt    DateTime?
  readAt         DateTime?
  failureReason  String?
  reactions      Json         @default("[]")
  isEdited       Boolean      @default(false)
  editedAt       DateTime?
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([messageId, recipientId])
  @@index([organizationId])
  @@index([conversationId, status])
  @@index([recipientId, status, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("message_statuses")
}

// Typing indicators and online presence live in the Redis-backed realtime
// bus (src/lib/realtime/bus.ts); their former tables were dropped.

// ============================================================================
// CALENDAR
// ============================================================================

model Event {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  title                String
  description          String?
  type                 String
  status               String       @default("scheduled")
  priority             String       @default("medium")
  startDate            DateTime
  endDate              DateTime
  allDay               Boolean      @default(false)
  timezone             String       @default("UTC")
  location             Json?
  propertyId           String?
  unitNumber           String?
  organizerId          String
  organizer            User         @relation("EventOrganizer", fields: [organizerId], references: [id])
  attendees            Json         @default("[]")
  attendeeIds          String[]     @default([])
  tenantId             String?
  leaseId              String?
  maintenanceRequestId String?
  recurrence           Json?
  parentEventId        String?
  isRecurring          Boolean      @default(false)
  reminders            Json         @default("[]")
  metadata             Json         @default("{}")
  attachments          String[]     @default([])
  notes                String?
  createdById          String
  updatedById          String?
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  invitations  EventInvitation[]
  reminderRows EventReminder[]

  @@index([organizationId])
  @@index([startDate, endDate])
  @@index([organizerId, startDate])
  @@index([propertyId, startDate])
  @@index([attendeeIds], type: Gin)
  @@map("events")
}

model EventInvitation {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  eventId            String
  event              Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterId          String
  inviter            User         @relation("InvitationInviter", fields: [inviterId], references: [id])
  inviteeId          String?
  invitee            User?        @relation("InvitationInvitee", fields: [inviteeId], references: [id])
  inviteeEmail       String
  inviteeName        String
  invitationToken    String       @unique
  status             String       @default("pending")
  respondedAt        DateTime?
  responseMessage    String?
  invitationSentAt   DateTime     @default(now())
  remindersSent      Int          @default(0)
  lastReminderSentAt DateTime?
  metadata           Json         @default("{}")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([eventId, inviteeEmail])
  @@index([organizationId])
  @@index([inviteeId])
  @@index([inviterId])
  @@index([status])
  @@map("event_invitations")
}

model EventReminder {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  eventId          String
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  type             String       @default("email")
  minutesBefore    Int
  scheduledFor     DateTime
  sent             Boolean      @default(false)
  sentAt           DateTime?
  deliveryStatus   String       @default("pending")
  deliveryAttempts Int          @default(0)
  lastAttemptAt    DateTime?
  errorMessage     String?
  customMessage    String?
  template         String       @default("default")
  metadata         Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([eventId, userId, minutesBefore])
  @@index([organizationId])
  @@index([scheduledFor, sent])
  @@map("event_reminders")
}

model CalendarSettings {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  settings       Json         @default("{}") // defaultView/businessHours/eventColors/integrations/…
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("calendar_settings")
}

// ============================================================================
// ENGAGEMENT & AUDIT
// ============================================================================

model Announcement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  content        String
  priority       String       @default("normal")
  type           String       @default("general")
  targetAudience Json         @default("{}")
  publishedAt    DateTime?
  scheduledFor   DateTime?
  expiresAt      DateTime?
  attachments    Json         @default("[]")
  actionButton   Json?
  views          Json         @default("[]")
  reactions      Json         @default("[]")
  status         String       @default("draft")
  isSticky       Boolean      @default(false)
  allowComments  Boolean      @default(true)
  createdById    String
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status, publishedAt(sort: Desc)])
  @@index([isSticky(sort: Desc), publishedAt(sort: Desc)])
  @@map("announcements")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  title          String
  message        String
  type           String       @default("system")
  priority       String       @default("normal")
  read           Boolean      @default(false)
  readAt         DateTime?
  actionUrl      String?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model PushSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  endpoint       String       @unique // web: push endpoint URL · native: the FCM device token
  p256dh         String? // web-push VAPID keys — null for native tokens
  auth           String?
  userAgent      String?
  platform       String       @default("web") // web | ios | android — mobile-ready
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  category        String
  action          String
  severity        String       @default("low")
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  userEmail       String?
  userRole        String?
  // The actor's name when they acted: the entry keeps naming them after a
  // rename, and after their user row is deleted (userId goes null).
  userName        String?
  impersonatedBy  String?
  resourceType    String?
  resourceId      String?
  resourceName    String?
  description     String
  // Catalogue key + parameters the sentence is rendered from, in the reader's
  // language (src/lib/audit/render.ts). `description` is the English fallback.
  messageKey      String?
  messageParams   Json?
  details         Json?
  oldValues       Json?
  newValues       Json?
  ipAddress       String?
  userAgent       String?
  requestId       String?
  sessionId       String?
  timestamp       DateTime     @default(now())
  source          String       @default("web")
  tags            String[]     @default([])
  retentionDate   DateTime?
  complianceFlags String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([category, timestamp(sort: Desc)])
  @@index([severity, timestamp(sort: Desc)])
  @@index([resourceType, resourceId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@index([organizationId, userId, timestamp(sort: Desc)])
  @@map("audit_logs")
}

model PropertyStatusAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  propertyName   String
  eventType      String
  oldStatus      String?
  newStatus      String
  triggeredBy    String
  triggerSource  String
  unitChanges    Json         @default("[]")
  metadata       Json         @default("{}")
  timestamp      DateTime     @default(now())
  userId         String?
  sessionId      String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([propertyId, timestamp(sort: Desc)])
  @@index([eventType, timestamp(sort: Desc)])
  @@map("property_status_audit_logs")
}

// ============================================================================
// SETTINGS (post-consolidation: 3 org/user settings tables)
// ============================================================================

model SystemSettings {
  id              String       @id @default(cuid())
  organizationId  String       @unique // one settings document per organization
  organization    Organization @relation(fields: [organizationId], references: [id])
  branding        Json         @default("{}")
  email           Json         @default("{}")
  payment         Json         @default("{}")
  paymentGateways Json         @default("{}")
  security        Json         @default("{}")
  maintenance     Json         @default("{}")
  integrations    Json         @default("{}")
  application     Json         @default("{}")
  notifications   Json         @default("{}")
  backup          Json         @default("{}")
  isActive        Boolean      @default(true)
  version         Int          @default(1)
  createdById     String?
  updatedById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("system_settings")
}

model ProfileSettings {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  profile        Json         @default("{}") // names/contact/social/emergency/preferences
  isActive       Boolean      @default(true)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("profile_settings")
}

model DisplaySettings {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  theme          String       @default("system")
  language       String       @default("ar")
  timezone       String       @default("Asia/Riyadh")
  currency       String       @default("SAR")
  dateFormat     String       @default("DD/MM/YYYY")
  timeFormat     String       @default("12h")
  contrast       Boolean      @default(false)
  compact        Boolean      @default(false)
  rtl            Boolean      @default(false)
  navColor       String       @default("integrate")
  preferences    Json         @default("{}") // fonts/density/colorScheme/dashboard/tables/charts/accessibility
  branding       Json         @default("{}") // org logos/colors/company info (+ r2 asset metadata)
  customCSS      String?
  isActive       Boolean      @default(true)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("display_settings")
}
