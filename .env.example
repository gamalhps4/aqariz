# PropertyPro Environment Variables

# PostgreSQL connection (Prisma). Local dev example:
DATABASE_URL="postgresql://propertypro_app:propertypro_dev@localhost:5432/propertypro_saas"

# Connection pool and transaction budgets (optional — defaults suit a database
# a few milliseconds away). Every query opens its own transaction to stamp the
# RLS settings, so a handler that fans out needs one connection per query at
# once; raise POOL_MAX and the transaction budgets when the database is remote
# enough that a round trip is tens of milliseconds, and lower them when it is
# on localhost. DATABASE_POOL_MAX x app instances must stay under the server's
# max_connections.
# DATABASE_POOL_MAX=20
# DATABASE_POOL_MIN=4
# DATABASE_POOL_IDLE_MS=60000
# DATABASE_TX_MAX_WAIT_MS=15000
# DATABASE_TX_TIMEOUT_MS=20000

# Better Auth. BETTER_AUTH_SECRET also signs calendar RSVP links.
# (Legacy NEXTAUTH_URL / NEXTAUTH_SECRET / AUTH_SECRET are read as fallbacks,
# so a pre-migration deployment keeps working without changes.)
BETTER_AUTH_URL=yourdomain-url
BETTER_AUTH_SECRET=your-auth-secret
AUTH_TRUST_HOST=true
# Alternative: specify the exact URL
AUTH_URL=yourdomain-url

# Cloudflare R2 (Replace with your actual keys from https://dash.cloudflare.com)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-custom-domain.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-custom-domain.com


# ---------------------------------------------------------------------------
# PLATFORM Stripe — subscription revenue only
# ---------------------------------------------------------------------------
# This is YOUR Stripe account: the one organizations pay their PropertyPro
# subscription into. It is never used to collect rent.
#
# Each organization collects from its own tenants using its OWN Stripe and
# PayPal credentials, which they enter in Settings -> Payments and which are
# stored (encrypted) against their organization. There are deliberately no
# env vars for that rail: an organization that configures nothing simply
# cannot collect online. Sharing one key across both rails meant every
# unconfigured organization's rent landed in the platform's account.
PLATFORM_STRIPE_SECRET_KEY=sk_live_your-platform-secret-key
STRIPE_BILLING_WEBHOOK_SECRET=whsec_your-billing-webhook-secret

# DEPRECATED. Read as a fallback for PLATFORM_STRIPE_SECRET_KEY so existing
# deployments keep working through the rename. Set the explicit name above and
# delete this line.
# STRIPE_SECRET_KEY=

# REMOVED: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY and STRIPE_WEBHOOK_SECRET.
# Both belonged to the tenant-collection rail, which is now per-organization.
# The browser gets the current organization's publishable key from
# /api/payments/config, and each organization sets its own webhook secret.

# SaaS trial and usage limits
SAAS_TRIAL_PLAN=professional
PLAN_FREE_PROPERTIES=3
PLAN_FREE_MEMBERS=3
PLAN_STARTER_PROPERTIES=25
PLAN_STARTER_MEMBERS=10
PLAN_PROFESSIONAL_PROPERTIES=100
PLAN_PROFESSIONAL_MEMBERS=50

# NOTE: there are no STRIPE_PRICE_* variables any more. Stripe prices are
# created from the amount a super-admin sets in the Plans console, so the
# advertised price and the billed price cannot drift apart. Run
# `pnpm sync:stripe-prices` if the two ever need reconciling.

# Reverse proxies in front of the app. SECURITY-RELEVANT: proxies append to
# X-Forwarded-For rather than replacing it, so with a proxy in front the
# leftmost entry is whatever the caller sent — reading it lets anyone defeat
# the per-IP limits on signup, password reset and error reporting.
#   0  no proxy, or a platform that strips client XFF (Vercel)
#   1  one proxy — Dokploy/Traefik, nginx, Caddy, Cloudflare alone
#   2  e.g. Cloudflare in front of Traefik
TRUSTED_PROXY_COUNT=0

# Redis. Optional for a single instance (an in-memory window is used instead),
# but REQUIRED once the app runs more than one replica — otherwise each
# replica enforces its own separate rate-limit counters.
# REDIS_URL=redis://localhost:6379

# Required for authenticated scheduled jobs. Generate a long random value.
# Nothing runs on a schedule until a scheduler calls the /api/cron/* routes —
# see docs/scheduled-jobs.md — this deployment uses Dokploy's Schedules tab.
CRON_SECRET=replace-with-a-long-random-secret

# Demo-data tooling (/api/demo-data and /api/seed/*, also under /api/v1).
# SECURITY-RELEVANT: these routes write sample records into an organization
# and hard-delete its data — messages, payments, invoices, leases, tenants,
# buildings and users, archived rows included. In production they answer 403
# unless this is exactly "true". Leave it unset on a live deployment; set it
# only on a demo instance that runs a production build. Deleting still needs
# the account owner (or a platform super admin) holding the permanent-delete
# permission, and is written to the audit log.
# ALLOW_PRODUCTION_DEMO_DATA_API=true

# Subscription lifecycle timings (optional — defaults shown).
# Days before trial end that the warning email is sent:
BILLING_TRIAL_WARNING_DAYS=3
# Days a past-due organization keeps its paid entitlements:
BILLING_DUNNING_GRACE_DAYS=7
# Days past due before the organization is suspended:
BILLING_DUNNING_SUSPEND_DAYS=21

# Legal pages (/terms, /privacy). Fill these in before launch — the copy is a
# reviewed-by-counsel template, and these are the blanks it reads.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_LEGAL_ADDRESS=

# Email Configuration (SMTP)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_FROM=your-email@gmail.com

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Application Configuration(optional)
APP_NAME=propertypro
APP_URL=http://localhost:3000
SAAS_ROOT_DOMAIN=localhost
NEXT_PUBLIC_SAAS_ROOT_DOMAIN=localhost
SUPPORT_EMAIL=support@propertpro.com

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@propertypro.app
                     
# 32 random bytes encoded as base64 (for example: openssl rand -base64 32).
# Back this value up securely; changing it makes encrypted SSNs and OAuth tokens unreadable.
DATA_ENCRYPTION_KEY=

# --- Mobile / scale-out (Phase 4, all optional) ------------------------------
# Native push via Firebase Cloud Messaging: paste the service-account JSON as
# one value. Unset = native sends skipped, web push unaffected.
# FCM_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
# Cross-instance realtime (SSE fan-out) — required when running >1 server
# instance. Unset = in-process bus (single instance / dev).
# REDIS_URL=redis://localhost:6379

# --- SMS and WhatsApp (all optional; unset = that channel is skipped) --------
# Each office sets its own provider in Settings → SMS & WhatsApp; offices
# without one send through the Super Admin's default gateway (Admin →
# Settings → SMS & WhatsApp), within their package's monthly message quota.
# These variables are the LAST fallback, used only while no default gateway
# is saved — a server configured before those screens existed still sends.
#
# The country code applied to a phone number typed without one, e.g. 966 turns
# 0501234567 into +966501234567. Numbers already in +E.164 are left alone.
# Unset, the active region's code is used (Saudi Arabia: 966).
# DEFAULT_COUNTRY_CODE=966
#
# SMS — pick one provider: unifonic | taqnyat | msegat | twilio
# SMS_PROVIDER=unifonic
# UNIFONIC_APP_SID=your-unifonic-app-sid
# UNIFONIC_SENDER_ID=PropertyPro
# UNIFONIC_API_URL=https://el.cloud.unifonic.com/rest/SMS/messages
#
# SMS_PROVIDER=taqnyat
# TAQNYAT_API_TOKEN=your-taqnyat-bearer-token
# TAQNYAT_SENDER_ID=PropertyPro
#
# SMS_PROVIDER=msegat
# MSEGAT_USERNAME=your-msegat-username
# MSEGAT_API_KEY=your-msegat-api-key
# MSEGAT_SENDER_ID=PropertyPro
#
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_SMS_FROM=+15551234567
#
# WhatsApp — "meta" is the WhatsApp Cloud API, "twilio" reuses the credentials
# above. WhatsApp only allows free-form text inside the 24-hour service
# window; reminders go out as approved templates, which are set per event and
# language on the default gateway in Admin → Settings (not here).
# WHATSAPP_PROVIDER=meta
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
# WHATSAPP_APP_SECRET=your-meta-app-secret     # verifies delivery reports
# WHATSAPP_VERIFY_TOKEN=any-random-string      # Meta webhook handshake
# WHATSAPP_API_VERSION=v23.0
#
# WHATSAPP_PROVIDER=twilio
# TWILIO_WHATSAPP_FROM=whatsapp:+15551234567
